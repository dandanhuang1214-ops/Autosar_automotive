                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>ValueB</SHORT-NAME>
                  <DEFINITION-REF>/Synthetic/ComGroupSignal</DEFINITION-REF>
                </ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>PacketA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/ComIPdu</DEFINITION-REF>
