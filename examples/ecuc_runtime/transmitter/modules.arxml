<?xml version='1.0' encoding='utf-8'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Telemetry</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>Com</SHORT-NAME>
          <DEFINITION-REF>/Synthetic/Com</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ValueA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/ComSignal</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF>/Synthetic/ComSignal/ComBitSize</DEFINITION-REF>
                  <VALUE>8</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>PacketA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/ComIPdu</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF>/Synthetic/ComIPdu/ComIPduDirection</DEFINITION-REF>
                  <VALUE>SEND</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
              </PARAMETER-VALUES>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/ComIPdu/ComIPduSignalRef</DEFINITION-REF>
                  <VALUE-REF>/Telemetry/Com/ValueA</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/ComIPdu/ComPduIdRef</DEFINITION-REF>
                  <VALUE-REF>/Telemetry/EcuC/A</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>EcuC</SHORT-NAME>
          <DEFINITION-REF>/Synthetic/EcuC</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>A</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/Pdu</DEFINITION-REF>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>C</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/Pdu</DEFINITION-REF>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>PduR</SHORT-NAME>
          <DEFINITION-REF>/Synthetic/PduR</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>RouteA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/PduRRoutingPath</DEFINITION-REF>
              <SUB-CONTAINERS>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>Start</SHORT-NAME>
                  <DEFINITION-REF>/Synthetic/PduRSrcPdu</DEFINITION-REF>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF>/Synthetic/PduRSrcPdu/PduRSrcPduRef</DEFINITION-REF>
                      <VALUE-REF>/Telemetry/EcuC/A</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-CONTAINER-VALUE>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>End</SHORT-NAME>
                  <DEFINITION-REF>/Synthetic/PduRDestPdu</DEFINITION-REF>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF>/Synthetic/PduRDestPdu/PduRDestPduRef</DEFINITION-REF>
                      <VALUE-REF>/Telemetry/EcuC/C</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>CanIf</SHORT-NAME>
          <DEFINITION-REF>/Synthetic/CanIf</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>PortA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanIfTxPduCfg</DEFINITION-REF>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanIfTxPduCfg/CanIfTxPduRef</DEFINITION-REF>
                  <VALUE-REF>/Telemetry/EcuC/C</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanIfTxPduCfg/CanIfTxPduBufferRef</DEFINITION-REF>
                  <VALUE-REF>/Telemetry/CanIf/Buffer</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            <PARAMETER-VALUES><ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF>/Synthetic/CanIfTxPduCfg/CanIfTxPduCanId</DEFINITION-REF><VALUE>768</VALUE></ECUC-NUMERICAL-PARAM-VALUE></PARAMETER-VALUES></ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>Buffer</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanIfBufferCfg</DEFINITION-REF>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanIfBufferCfg/CanIfBufferHthRef</DEFINITION-REF>
                  <VALUE-REF>/Telemetry/CanIf/HandleA</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>HandleA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanIfHthCfg</DEFINITION-REF>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanIfHthCfg/CanIfHthIdSymRef</DEFINITION-REF>
                  <VALUE-REF>/Telemetry/Can/ObjectA</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>Can</SHORT-NAME>
          <DEFINITION-REF>/Synthetic/Can</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ObjectA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanHardwareObject</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF>/Synthetic/CanHardwareObject/CanObjectType</DEFINITION-REF>
                  <VALUE>TRANSMIT</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
              </PARAMETER-VALUES>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanHardwareObject/CanControllerRef</DEFINITION-REF>
                  <VALUE-REF>/Telemetry/Can/Controller</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>Controller</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanController</DEFINITION-REF>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>