{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/agent-evidence-plan.schema.json",
  "title": "Agent Evidence Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id", "artifact_type", "schema_version", "scope", "goal", "steps", "boundary"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_type": {"const": "agent-evidence-plan"},
    "schema_version": {"const": "agent-evidence-plan-0.1"},
    "scope": {
      "enum": [
        "project_detail",
        "reviewed_knowledge",
        "project_and_reviewed_knowledge"
      ]
    },
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "arguments"],
        "properties": {
          "tool_name": {
            "enum": ["project_query_facts", "knowledge_retrieve_reviewed"]
          },
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question"],
            "properties": {
              "question": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        }
      }
    },
    "boundary": {"type": "string", "minLength": 1}
  }
}
