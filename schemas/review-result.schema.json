{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/review-result.schema.json",
  "title": "Evidence-backed Engineering Review Result",
  "type": "object",
  "required": ["artifact_type", "schema_version", "run_id", "request_id", "question", "status", "mode", "minimum_coverage", "coverage", "artifact_ids", "evidence_unit_count", "evidence_units_file", "checks", "citations", "findings", "refusal_reasons", "citation_validation"],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "review-result-0.5"}}},
      "then": {"required": ["drift_catalog"]}
    }
  ],
  "properties": {
    "artifact_type": {"const": "engineering-review-result"},
    "schema_version": {"enum": ["review-result-0.1", "review-result-0.2", "review-result-0.3", "review-result-0.4", "review-result-0.5"]},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string"},
    "request_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "status": {"enum": ["answered", "partial", "refused"]},
    "mode": {"const": "retrieval-only"},
    "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "artifact_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_unit_count": {"type": "integer", "minimum": 0},
    "evidence_units_file": {"const": "evidence-units.json"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "statement", "status", "citation_ids"],
        "properties": {
          "check_id": {"type": "string"},
          "statement": {"type": "string"},
          "status": {"enum": ["supported", "unsupported", "conflicted", "blocked"]},
          "citation_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "citations": {"type": "array", "items": {"$ref": "citation.schema.json"}},
    "drift_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "claim_key", "baseline_artifact_id", "candidate_artifact_id", "status", "citation_ids"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "claim_key": {"type": "string", "minLength": 1},
          "baseline_artifact_id": {"type": "string", "minLength": 1},
          "candidate_artifact_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["stable", "drifted", "not-comparable"]},
          "citation_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "refusal_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "artifact_id": {"type": "string"},
          "check_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "citation_validation": {
      "type": "object",
      "required": ["status", "citation_count", "valid_count", "reasons"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "citation_count": {"type": "integer", "minimum": 0},
        "valid_count": {"type": "integer", "minimum": 0},
        "reasons": {"type": "array"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
