{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/citation.schema.json",
  "title": "Validated Engineering Citation",
  "type": "object",
  "required": ["citation_id", "evidence_id", "artifact_id", "source", "source_sha256", "locator", "content", "content_sha256", "supports_checks"],
  "properties": {
    "citation_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator": {
      "type": "object",
      "required": ["type", "pointer"],
      "properties": {
        "type": {"const": "json-pointer"},
        "pointer": {"type": "string"}
      },
      "additionalProperties": false
    },
    "content": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supports_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
