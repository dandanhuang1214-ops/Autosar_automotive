{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/resolved-dependency-inventory.schema.json",
  "title": "Resolved Workbench Dependency Inventory",
  "type": "object",
  "required": ["artifact_type", "schema_version", "python", "implementation", "platform", "packages"],
  "properties": {
    "artifact_type": {"const": "resolved-dependency-inventory"},
    "schema_version": {"const": "resolved-dependency-inventory-0.1"},
    "python": {"type": "string", "minLength": 1},
    "implementation": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
