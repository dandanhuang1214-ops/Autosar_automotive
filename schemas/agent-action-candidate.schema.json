{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/agent-action-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id", "schema_version", "checkpoint_id", "registry_binding_sha256",
    "goal", "issued_by", "capability_binding_sha256", "action", "evidence_ids",
    "execution_authorized", "tool_invoked", "boundary"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "agent-action-candidate-0.1"},
    "checkpoint_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "issued_by": {"const": "workbench-control-plane"},
    "capability_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "permission", "arguments", "call_id"],
      "properties": {
        "tool_name": {"type": "string", "minLength": 1},
        "permission": {"const": "execute"},
        "arguments": {"type": "object"},
        "call_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "execution_authorized": {"const": false},
    "tool_invoked": {"const": false},
    "boundary": {
      "const": "This exact action candidate was issued by the Workbench control plane. It is not approval or authenticated authorization, and no tool was invoked."
    }
  }
}
