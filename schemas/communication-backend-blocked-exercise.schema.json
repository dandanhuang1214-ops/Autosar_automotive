    "status": {"const": "passed"},
    "cli_outcome": {"const": "failure"},
    "blocked_reason": {"enum": ["interface_missing", "unsupported_platform"]},
    "runtime_backend": {"const": "python-can socketcan"},
    "binding_count": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
