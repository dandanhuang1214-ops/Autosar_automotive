{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/communication-backend-blocked-exercise.schema.json",
  "title": "Communication Backend Blocked Exercise",
  "type": "object",
  "required": [
    "artifact_type", "schema_version", "status", "cli_outcome",
    "blocked_reason", "runtime_backend", "binding_count"
