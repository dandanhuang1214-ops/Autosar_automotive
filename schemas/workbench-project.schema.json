                      "not": {
                        "const": "arxml"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "workbench-project-0.5"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
