                "tool_logs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "stage",
              "pointer",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "text": {
                "type": "string",
                "pattern": "\\S"
              },
              "stage": {
                "const": "ecuc"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/checks/(communication|application|task_bindings|mode_rules|impact|policy\\.[A-Za-z0-9_.-]+|diagnostic\\.[A-Za-z0-9_.-]+)/status$"
              },
              "expected": {
                "const": "passed"
              }
            }
          },
          "minItems": 1
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "object_id",
              "condition"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "object_id": {
                "type": "string",
                "pattern": "^ecuc:/[^\\s/*~]+(?:/[^\\s/*~]+)*$"
              },
              "condition": {
                "enum": [
                  "exists_complete",
                  "unchanged"
                ]
              },
              "field_group": {
                "enum": [
                  "parameters",
                  "references"
                ]
              },
              "definition": {
                "type": "string",
                "pattern": "^/[^\\s/*~]+(?:/[^\\s/*~]+)*$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "condition": {
                      "const": "unchanged"
                    }
                  }
                },
                "then": {
                  "required": [
                    "field_group",
                    "definition"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "field_group"
                        ]
                      },
                      {
                        "required": [
                          "definition"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "diagnostic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "execution",
            "policy_ids",
            "relation",
            "identity"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "execution": {
              "type": "string",
              "pattern": "\\S"
            },
            "policy_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            },
            "relation": {
              "enum": [
                "acceptance-dependency",
                "configuration-semantic"
              ]
            },
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_commit",
                "channel",
                "request_id",
                "response_id",
                "did",
                "expected_data_hex"
              ],
              "properties": {
                "source_commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "channel": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,15}$"
                },
                "request_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2047
                },
                "response_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2047
                },
                "did": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "expected_data_hex": {
                  "type": "string",
                  "pattern": "^(?:[A-Fa-f0-9]{2})+$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
