{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/project-explanation-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "schema_version",
    "policy_version",
    "report_sha256",
    "project_status",
    "question",
    "facts",
    "boundary"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": "project-explanation-request-0.1"
    },
    "policy_version": {
      "const": "project-fact-selection-0.1"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "unassessed"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "source_kind",
          "artifact_id",
          "source_sha256",
          "pointer",
          "value"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_kind": {
            "const": "project"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
