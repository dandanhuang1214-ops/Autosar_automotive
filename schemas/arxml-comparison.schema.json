{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/arxml-comparison.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "status",
    "baseline",
    "candidate",
    "changes",
    "source_bytes_changed",
    "boundaries"
  ],
  "properties": {
    "artifact_type": {
      "const": "arxml-comparison"
    },
    "schema_version": {
      "const": "arxml-comparison-0.1"
    },
    "status": {
      "enum": [
        "stable",
        "changed",
        "not-comparable"
      ]
    },
    "baseline": {
      "$ref": "#/$defs/import"
    },
    "candidate": {
      "$ref": "#/$defs/import"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "change",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "change": {
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "locator",
                  "facts"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "locator": {
                    "type": "string"
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "value",
                        "attributes"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "attributes": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "locator",
                  "facts"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "locator": {
                    "type": "string"
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "value",
                        "attributes"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "attributes": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "source_bytes_changed": {
      "type": "boolean"
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "status",
        "coverage",
        "autosar_version",
        "namespace",
        "source",
        "inventory",
        "objects",
        "references",
        "unsupported",
        "findings",
        "boundaries"
      ],
      "properties": {
        "artifact_type": {
          "const": "arxml-import"
        },
        "schema_version": {
          "const": "arxml-import-0.1"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "coverage": {
          "enum": [
            "partial",
            "supported-subset"
          ]
        },
        "autosar_version": {
          "const": "4-3-0"
        },
        "namespace": {
          "const": "http://autosar.org/schema/r4.0"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "content_base64",
            "producer"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "content_base64": {
              "type": "string"
            },
            "producer": {
              "type": "object"
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "locator",
              "facts"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "value",
                    "attributes"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "attributes": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "locator",
              "kind",
              "target",
              "dest"
            ],
            "properties": {
              "owner": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "dest": {
                "type": "string"
              }
            }
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locator",
              "kind",
              "name"
            ],
            "properties": {
              "locator": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "locator",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
