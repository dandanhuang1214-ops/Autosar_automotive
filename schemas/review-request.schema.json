{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/review-request.schema.json",
  "title": "Evidence-backed Engineering Review Request",
  "type": "object",
  "required": ["schema_version", "request_id", "question", "checks", "artifact_registry", "artifact_ids", "allowed_confidentiality"],
  "properties": {
    "schema_version": {"enum": ["review-request-0.1", "review-request-0.2"]},
    "request_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
    "allowed_confidentiality": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["public", "private-local", "company-restricted"]}
    },
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "source", "confidentiality"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "confidentiality": {"enum": ["public", "private-local", "company-restricted"]},
          "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "statement", "terms"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "assertion": {
            "type": "object",
            "required": ["claim_key", "operator", "observations"],
            "properties": {
              "claim_key": {"type": "string", "minLength": 1},
              "operator": {"enum": ["equals", "all-equal"]},
              "expected": {"type": ["string", "number", "boolean", "null"]},
              "observations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["artifact_id", "locator"],
                  "properties": {
                    "artifact_id": {"type": "string", "minLength": 1},
                    "locator": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": ["type", "pointer"],
                          "properties": {
                            "type": {"const": "json-pointer"},
                            "pointer": {"type": "string"}
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "required": ["type", "start_line", "end_line"],
                          "properties": {
                            "type": {"const": "line-range"},
                            "start_line": {"type": "integer", "minimum": 1},
                            "end_line": {"type": "integer", "minimum": 1}
                          },
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
