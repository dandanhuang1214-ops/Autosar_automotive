{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/review-evaluation.schema.json",
  "title": "Deterministic Engineering Review Evaluation Manifest",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "repeat_runs", "cases"],
  "properties": {
    "schema_version": {"enum": ["review-evaluation-0.1", "review-evaluation-0.2"]},
    "evaluation_id": {"type": "string", "minLength": 1},
    "repeat_runs": {"type": "integer", "minimum": 3},
    "repeatability_excluded_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "request", "expected_status", "expected_checks", "expected_refusal_codes", "expected_findings", "gold_evidence_sets"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "request": {"type": "string", "minLength": 1},
          "expected_status": {"enum": ["answered", "partial", "refused"]},
          "expected_checks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"enum": ["supported", "unsupported", "conflicted", "blocked"]}
          },
          "expected_refusal_codes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "expected_findings": {
            "type": "array",
            "items": {"$ref": "finding.schema.json"}
          },
          "gold_evidence_sets": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["artifact_id", "locator"],
                "properties": {
                  "artifact_id": {"type": "string", "minLength": 1},
                  "locator": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["type", "pointer"],
                        "properties": {
                          "type": {"const": "json-pointer"},
                          "pointer": {"type": "string"}
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": ["type", "start_line", "end_line"],
                        "properties": {
                          "type": {"const": "line-range"},
                          "start_line": {"type": "integer", "minimum": 1},
                          "end_line": {"type": "integer", "minimum": 1}
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
