{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/communication-evidence.schema.json",
  "title": "Static-to-runtime Communication Chain Evidence",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "run_id",
    "started_at",
    "status",
    "local_ecu",
    "source_artifacts",
    "static_validation_status",
    "runtime_status",
    "runtime_backend",
    "runtime_applicability_profile",
    "path_count",
    "bound_count",
    "finding_count",
    "findings",
    "bindings"
  ],
  "properties": {
    "artifact_type": {"const": "communication-chain-evidence"},
    "schema_version": {"const": "communication-evidence-0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed"]},
    "local_ecu": {"type": ["string", "null"], "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["artifact_type", "source", "sha256"],
        "properties": {
          "artifact_type": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "static_validation_status": {"enum": ["passed", "failed"]},
    "runtime_status": {"enum": ["passed", "failed"]},
    "runtime_backend": {"type": "string", "minLength": 1},
    "runtime_applicability_profile": {"type": "object"},
    "path_count": {"type": "integer", "minimum": 0},
    "bound_count": {"type": "integer", "minimum": 0},
    "finding_count": {"type": "integer", "minimum": 0},
    "findings": {"type": "array"},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identity", "status", "static_path", "runtime_observation", "finding_codes"],
        "properties": {
          "identity": {"type": "string", "minLength": 3},
          "status": {"enum": ["bound", "failed"]},
          "static_path": {"type": "object"},
          "runtime_observation": {"type": ["object", "null"]},
          "finding_codes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
