{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/uds-did-read.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "created_at", "status", "reason", "target", "target_identity_verified", "profile", "bus_config", "probe", "isolation", "request_payload_hex", "response_payload_hex", "expected_data_hex", "actual_data_hex", "negative_response_code", "transport_errors", "frames", "dropped_frame_count", "capture", "source_artifacts"],
  "properties": {
    "artifact_type": {"const": "uds-did-read"},
    "schema_version": {"const": "uds-did-read-0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "reason": {"type": "string"},
    "target": {"type": "string", "minLength": 1},
    "target_identity_verified": {"const": false},
    "profile": {"$ref": "#/$defs/source"},
    "source_artifacts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/source"}},
    "bus_config": {"type": "object"},
    "probe": {"type": "object"},
    "isolation": {"type": "object"},
    "request_payload_hex": {"type": "string", "pattern": "^22[0-9A-F]{4}$"},
    "response_payload_hex": {"$ref": "#/$defs/hex"},
    "expected_data_hex": {"type": "string", "pattern": "^(?:[0-9A-F]{2}){1,4092}$"},
    "actual_data_hex": {"$ref": "#/$defs/hex"},
    "negative_response_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "transport_errors": {"type": "array", "items": {"type": "string"}},
    "frames": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["timestamp", "direction", "can_id_hex", "pci_type", "data_hex"],
        "properties": {
          "timestamp": {"type": "number"},
          "direction": {"enum": ["request", "response"]},
          "can_id_hex": {"type": "string", "pattern": "^0x[0-9A-F]{3}$"},
          "pci_type": {"enum": ["SF", "FF", "CF", "FC", "unknown"]},
          "data_hex": {"$ref": "#/$defs/hex"}
        }
      }
    },
    "dropped_frame_count": {"type": "integer", "minimum": 0},
    "capture": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/source"}]}
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^(?:[0-9A-F]{2})*$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
