  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence",
        "affected_objects"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "unassessed",
            "blocked"
          ]
        },
        "reason": {
          "enum": [
            "snapshots_not_comparable",
            "impact_coverage_incomplete",
            "explicit_dependencies_assessed",
            "coverage_missing",
            "structural_gap",
            "linked_in_scope"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "pointer"
          ],
          "properties": {
            "path": {
              "enum": [
                "ecuc/after/ecuc-review.json",
                "ecuc/ecuc-impact.json"
              ]
            },
            "pointer": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "affected_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      }
    },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence",
        "affected_objects",
        "policy",
        "observations"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "unassessed",
            "blocked"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "pointer"
          ],
          "properties": {
            "path": {
              "enum": [
                "ecuc/after/ecuc-review.json",
                "ecuc/ecuc-impact.json"
              ]
            },
            "pointer": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "affected_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "object_id",
            "condition"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "object_id": {
              "type": "string",
              "pattern": "^ecuc:/[^\\s/*~]+(?:/[^\\s/*~]+)*$"
            },
            "condition": {
              "enum": [
                "exists_complete",
                "unchanged"
              ]
            },
            "field_group": {
              "enum": [
                "parameters",
                "references"
              ]
            },
            "definition": {
              "type": "string",
              "pattern": "^/[^\\s/*~]+(?:/[^\\s/*~]+)*$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "condition": {
                    "const": "unchanged"
                  }
                }
              },
              "then": {
                "required": [
                  "field_group",
                  "definition"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "field_group"
                      ]
                    },
                    {
                      "required": [
                        "definition"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "object_pointers",
                "field_pointers",
                "values",
                "witness_pointers",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "unassessed",
                    "blocked"
                  ]
                },
                "reason": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "path": {
                  "enum": [
                    "ecuc/before/ecuc-review.json",
                    "ecuc/after/ecuc-review.json"
                  ]
                },
                "object_pointers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "field_pointers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "witness_pointers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "after": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "object_pointers",
                "field_pointers",
                "values",
                "witness_pointers",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "unassessed",
                    "blocked"
                  ]
                },
                "reason": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "path": {
                  "enum": [
                    "ecuc/before/ecuc-review.json",
                    "ecuc/after/ecuc-review.json"
                  ]
                },
                "object_pointers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "field_pointers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "witness_pointers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
