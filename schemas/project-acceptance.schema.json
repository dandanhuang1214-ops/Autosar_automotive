{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/project-acceptance.schema.json",
  "properties": {
    "schema_version": {
      "enum": [
        "project-acceptance-0.1",
        "project-acceptance-0.2",
        "project-acceptance-0.3",
        "project-acceptance-0.4",
        "project-acceptance-0.5",
        "project-acceptance-0.6"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "name",
        "status",
        "stages",
        "requirements",
        "source_artifacts"
      ],
      "properties": {
        "artifact_type": {
          "const": "project-acceptance"
        },
        "schema_version": {
          "enum": [
            "project-acceptance-0.1",
            "project-acceptance-0.2",
            "project-acceptance-0.3",
            "project-acceptance-0.4",
            "project-acceptance-0.5"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical",
            "mapping",
            "communication"
          ],
          "properties": {
            "canonical": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "skipped"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "mapping": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "skipped"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "communication": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "skipped"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "generation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "skipped"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "arxml": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "skipped"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "external_ecu": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "skipped"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "stage",
              "pointer",
              "expected",
              "status",
              "reason",
              "actual",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "text": {
                "type": "string",
                "pattern": "\\S"
              },
              "stage": {
                "enum": [
                  "canonical",
                  "mapping",
                  "communication",
                  "generation",
                  "arxml",
                  "external_ecu"
                ]
              },
              "pointer": {
                "type": "string",
                "pattern": "^/(?:[^~]|~[01])*$"
              },
              "expected": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "blocked"
                ]
              },
              "reason": {
                "enum": [
                  "matched",
                  "value_mismatch",
                  "evidence_missing",
                  "stage_not_run",
                  "backend_unavailable"
                ]
              },
              "actual": {},
              "evidence": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256",
                      "pointer"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "pointer": {
                        "type": "string",
                        "pattern": "^/(?:[^~]|~[01])*$"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "sha256"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "comparison_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "local_ecu",
            "vectors"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "local_ecu": {
              "type": "string",
              "pattern": "\\S"
            },
            "vectors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "message",
                  "direction",
                  "signals",
                  "timeout_seconds"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+$",
                    "not": {
                      "pattern": "[^A-Za-z0-9_.-]"
                    }
                  },
                  "message": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "direction": {
                    "enum": [
                      "tx",
                      "rx"
                    ]
                  },
                  "signals": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    }
                  },
                  "timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 5
                  }
                }
              }
            },
            "arxml_semantics": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "external_execution": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "project-acceptance-0.3",
                  "project-acceptance-0.4",
                  "project-acceptance-0.5"
                ]
              }
            }
          },
          "then": {
            "required": [
              "comparison_basis"
            ]
          },
          "else": {
            "not": {
              "required": [
                "comparison_basis"
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "schema_version": {
                      "const": "project-acceptance-0.2"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "stages": {
                      "required": [
                        "generation"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "stages": {
                      "not": {
                        "required": [
                          "generation"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "project-acceptance-0.4",
                  "project-acceptance-0.5"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "stages": {
                "required": [
                  "arxml"
                ]
              },
              "comparison_basis": {
                "required": [
                  "arxml_semantics"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "stages": {
                "not": {
                  "required": [
                    "arxml"
                  ]
                }
              },
              "comparison_basis": {
                "not": {
                  "required": [
                    "arxml_semantics"
                  ]
                }
              },
              "requirements": {
                "items": {
                  "properties": {
                    "stage": {
                      "not": {
                        "const": "arxml"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "project-acceptance-0.5"
              }
            }
          },
          "then": {
            "properties": {
              "stages": {
                "required": [
                  "external_ecu"
                ]
              },
              "comparison_basis": {
                "required": [
                  "external_execution"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "stages": {
                "not": {
                  "required": [
                    "external_ecu"
                  ]
                }
              },
              "comparison_basis": {
                "not": {
                  "required": [
                    "external_execution"
                  ]
                }
              },
              "requirements": {
                "items": {
                  "properties": {
                    "stage": {
                      "not": {
                        "const": "external_ecu"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "name",
        "status",
        "stages",
        "requirements",
        "comparison_basis",
        "source_artifacts"
      ],
      "properties": {
        "artifact_type": {
          "const": "project-acceptance"
        },
        "schema_version": {
          "const": "project-acceptance-0.6"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unassessed",
            "blocked"
          ]
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ecuc"
          ],
          "properties": {
            "ecuc": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "path"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "unassessed",
                    "blocked"
                  ]
                },
                "path": {
                  "const": "ecuc-stage.json"
                }
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "stage",
              "pointer",
              "expected",
              "status",
              "reason",
              "actual",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "text": {
                "type": "string",
                "pattern": "\\S"
              },
              "stage": {
                "const": "ecuc"
              },
              "pointer": {
                "enum": [
                  "/checks/communication/status",
                  "/checks/application/status",
                  "/checks/task_bindings/status",
                  "/checks/mode_rules/status",
                  "/checks/impact/status"
                ]
              },
              "expected": {
                "const": "passed"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unassessed",
                  "blocked"
                ]
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "actual": {
                "enum": [
                  "passed",
                  "failed",
                  "unassessed",
                  "blocked"
                ]
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "pointer",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "const": "ecuc-stage.json"
                  },
                  "pointer": {
                    "enum": [
                      "/checks/communication/status",
                      "/checks/application/status",
                      "/checks/task_bindings/status",
                      "/checks/mode_rules/status",
                      "/checks/impact/status"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          "minItems": 1
        },
        "comparison_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparison_key",
            "engine",
            "baseline_sha256"
          ],
          "properties": {
            "comparison_key": {
              "type": "string",
              "pattern": "\\S"
            },
            "engine": {
              "const": "ecuc-project-acceptance-0.1"
            },
            "baseline_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "sha256"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 1
        }
      }
    }
  ]
}
