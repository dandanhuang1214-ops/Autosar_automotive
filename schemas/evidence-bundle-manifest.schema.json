{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/evidence-bundle-manifest.schema.json",
  "title": "Portable Local Evidence Bundle Manifest",
  "type": "object",
  "required": ["artifact_type", "schema_version", "bundle_id", "created_at", "producer", "artifact_count", "total_bytes", "artifacts"],
  "properties": {
    "artifact_type": {"const": "evidence-bundle-manifest"},
    "schema_version": {"const": "evidence-bundle-manifest-0.1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "artifact_count": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 0},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "relative_path", "media_type", "artifact_type", "schema_version", "size_bytes", "sha256", "depends_on"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "media_type": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "schema_version": {"type": ["string", "null"]},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "ref", "sha256"],
              "properties": {
                "kind": {"enum": ["artifact", "external"]},
                "ref": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
