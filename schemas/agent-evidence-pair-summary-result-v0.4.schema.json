{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/agent-evidence-pair-summary-result-v0.4.schema.json",
  "title": "Agent Complete Evidence Pair Summary Result v0.4",
  "description": "Versioned wrapper preserving the fully verifiable v0.3 model transcript while deterministically appending a control-plane evidence boundary to the user-visible summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id", "artifact_type", "schema_version", "model_interface",
    "protocol_status", "semantic_assessment", "plan_id", "base_result",
    "model_summary", "summary", "evidence_ids", "evidence_boundary"
  ],
  "properties": {
    "result_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_type": {"const": "agent-evidence-pair-summary-result"},
    "schema_version": {"const": "agent-evidence-pair-summary-result-0.4"},
    "model_interface": {"const": "ollama-complete-pair-plain-text-summary-0.3+control-boundary-0.4"},
    "protocol_status": {"enum": ["passed", "refused", "blocked"]},
    "semantic_assessment": {"const": "unassessed"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_result": {"$ref": "https://automotive-workbench.local/schemas/agent-evidence-pair-summary-result.schema.json"},
    "model_summary": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
    "summary": {"type": ["string", "null"], "minLength": 1, "maxLength": 1500},
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "evidence_boundary": {"const": "证据边界（由控制面附加）：此摘要仅反映所引用项目报告中记录的证据；它本身不证明物理 ECU 行为、配置写入或实车执行，也不支持超出各检查已记录原因的根因判断。"}
  }
}
