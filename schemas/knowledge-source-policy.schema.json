{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/knowledge-source-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "profile", "documents"],
  "properties": {
    "schema_version": {"const": "knowledge-source-policy-0.1"},
    "policy_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"const": "agent-read"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "document_sha256", "authority", "review"],
        "properties": {
          "document_id": {"type": "integer", "minimum": 1},
          "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authority": {"enum": ["official", "user_reviewed"]},
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "reviewer", "reviewed_at"],
            "properties": {
              "decision": {"const": "approved"},
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
