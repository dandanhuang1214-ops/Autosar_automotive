{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/dtc-intent.schema.json",
  "title": "Vendor-neutral DTC Lifecycle Intent",
  "type": "object",
  "required": ["schema_version", "model_status", "ecu", "dtcs", "experiments"],
  "properties": {
    "schema_version": {"const": "dtc-intent-0.1"},
    "model_status": {"enum": ["research-intent", "vendor-validated", "unknown"]},
    "ecu": {"type": "string", "minLength": 1},
    "dtcs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "failure_threshold", "healing_threshold", "uds_initial_status"],
        "properties": {
          "code": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "name": {"type": "string", "minLength": 1},
          "failure_threshold": {"type": "integer", "minimum": 1, "maximum": 255},
          "healing_threshold": {"type": "integer", "minimum": 1, "maximum": 255},
          "uds_initial_status": {"type": "integer", "minimum": 0, "maximum": 255}
        },
        "additionalProperties": true
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dtc", "steps"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dtc": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event", "expected_state", "expected_status"],
              "properties": {
                "event": {"enum": ["fault_absent", "fault_present", "read_dtc", "clear_dtc"]},
                "status_mask": {"type": "integer", "minimum": 1, "maximum": 255},
                "expected_state": {"enum": ["absent", "pending", "confirmed", "healing", "healed"]},
                "expected_status": {"type": "integer", "minimum": 0, "maximum": 255}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
