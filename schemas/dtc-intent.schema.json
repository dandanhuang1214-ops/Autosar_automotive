{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/dtc-intent.schema.json",
  "title": "Vendor-neutral DTC Lifecycle Intent",
  "type": "object",
  "required": ["schema_version", "model_status", "ecu", "dtcs", "experiments", "cycle_experiments", "reset_experiments", "persistence_fault_experiments", "redundancy_experiments"],
  "properties": {
    "schema_version": {"const": "dtc-intent-0.1"},
    "model_status": {"enum": ["research-intent", "vendor-validated", "unknown"]},
    "ecu": {"type": "string", "minLength": 1},
    "dtcs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "failure_threshold", "healing_threshold", "aging_threshold", "uds_initial_status", "snapshot", "extended_data", "persistence"],
        "properties": {
          "code": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "name": {"type": "string", "minLength": 1},
          "failure_threshold": {"type": "integer", "minimum": 1, "maximum": 255},
          "healing_threshold": {"type": "integer", "minimum": 1, "maximum": 255},
          "aging_threshold": {"type": "integer", "minimum": 1, "maximum": 255},
          "uds_initial_status": {"type": "integer", "minimum": 0, "maximum": 255},
          "snapshot": {
            "type": "object",
            "required": ["trigger", "record_number", "dids"],
            "properties": {
              "trigger": {"const": "confirmed"},
              "record_number": {"type": "integer", "minimum": 1, "maximum": 254},
              "dids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["did", "codec", "length", "value"],
                  "properties": {
                    "did": {"type": "integer", "minimum": 0, "maximum": 65535},
                    "codec": {"const": "uint8"},
                    "length": {"const": 1},
                    "value": {"type": "integer", "minimum": 0, "maximum": 255}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "extended_data": {
            "type": "object",
            "required": ["retention", "records"],
            "properties": {
              "retention": {"const": "until_aged_or_cleared"},
              "records": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["record_number", "name", "source", "length", "uds_initial_value"],
                  "properties": {
                    "record_number": {"type": "integer", "minimum": 1, "maximum": 254},
                    "name": {"type": "string", "minLength": 1},
                    "source": {"enum": ["occurrence_counter", "aging_counter"]},
                    "length": {"const": 1},
                    "uds_initial_value": {"type": "integer", "minimum": 0, "maximum": 255}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "persistence": {
            "type": "object",
            "required": ["retained_data", "flush_event", "clear_updates_persistent_memory"],
            "properties": {
              "retained_data": {
                "type": "array",
                "prefixItems": [
                  {"const": "status"},
                  {"const": "snapshot"},
                  {"const": "extended_data"}
                ],
                "minItems": 3,
                "maxItems": 3
              },
              "flush_event": {"const": "explicit"},
              "clear_updates_persistent_memory": {"const": true}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dtc", "steps"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dtc": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event", "expected_state", "expected_status"],
              "properties": {
                "event": {"enum": ["fault_absent", "fault_present", "read_dtc", "clear_dtc"]},
                "status_mask": {"type": "integer", "minimum": 1, "maximum": 255},
                "expected_state": {"enum": ["absent", "pending", "confirmed", "healing", "healed"]},
                "expected_status": {"type": "integer", "minimum": 0, "maximum": 255}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "cycle_experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dtc", "steps"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dtc": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event", "expected_state", "expected_status", "expected_aging_counter", "expected_snapshot_stored", "expected_cycle_active"],
              "properties": {
                "event": {"enum": ["operation_cycle_start", "operation_cycle_end", "fault_present", "fault_absent", "read_snapshot"]},
                "expected_state": {"enum": ["absent", "pending", "confirmed", "healing", "healed", "aged_out"]},
                "expected_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_aging_counter": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_snapshot_stored": {"type": "boolean"},
                "expected_cycle_active": {"type": "boolean"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "reset_experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dtc", "steps"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dtc": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event", "expected_runtime_state", "expected_runtime_status", "expected_persistent_status", "expected_runtime_snapshot_stored", "expected_persistent_snapshot_stored", "expected_runtime_extended_data_stored", "expected_persistent_extended_data_stored"],
              "properties": {
                "event": {"enum": ["operation_cycle_start", "operation_cycle_end", "fault_present", "flush", "hard_reset", "clear_dtc"]},
                "expected_runtime_state": {"enum": ["absent", "pending", "confirmed"]},
                "expected_runtime_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_persistent_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_runtime_snapshot_stored": {"type": "boolean"},
                "expected_persistent_snapshot_stored": {"type": "boolean"},
                "expected_runtime_extended_data_stored": {"type": "boolean"},
                "expected_persistent_extended_data_stored": {"type": "boolean"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "persistence_fault_experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dtc", "steps"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dtc": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event", "expected_runtime_state", "expected_runtime_status", "expected_persistent_status", "expected_runtime_snapshot_stored", "expected_persistent_snapshot_stored", "expected_runtime_extended_data_stored", "expected_persistent_extended_data_stored", "expected_mirror_integrity", "expected_finding"],
              "properties": {
                "event": {"enum": ["operation_cycle_start", "operation_cycle_end", "fault_present", "flush", "inject_flush_failure", "corrupt_mirror", "hard_reset"]},
                "expected_runtime_state": {"enum": ["absent", "pending", "confirmed"]},
                "expected_runtime_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_persistent_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_runtime_snapshot_stored": {"type": "boolean"},
                "expected_persistent_snapshot_stored": {"type": "boolean"},
                "expected_runtime_extended_data_stored": {"type": "boolean"},
                "expected_persistent_extended_data_stored": {"type": "boolean"},
                "expected_mirror_integrity": {"type": "boolean"},
                "expected_finding": {"enum": ["", "DTC-PERSISTENCE-FLUSH-FAILED", "DTC-PERSISTENCE-MIRROR-CORRUPTED", "DTC-PERSISTENCE-RESTORE-FAILED"]}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "redundancy_experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "dtc", "steps"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dtc": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event", "expected_runtime_state", "expected_runtime_status", "expected_copy_a_status", "expected_copy_b_status", "expected_copy_a_generation", "expected_copy_b_generation", "expected_copy_a_integrity", "expected_copy_b_integrity", "expected_selected_copy", "expected_finding"],
              "properties": {
                "event": {"enum": ["operation_cycle_start", "operation_cycle_end", "fault_present", "flush", "corrupt_copy_a", "hard_reset"]},
                "expected_runtime_state": {"enum": ["absent", "pending", "confirmed"]},
                "expected_runtime_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_copy_a_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_copy_b_status": {"type": "integer", "minimum": 0, "maximum": 255},
                "expected_copy_a_generation": {"type": "integer", "minimum": 0},
                "expected_copy_b_generation": {"type": "integer", "minimum": 0},
                "expected_copy_a_integrity": {"type": "boolean"},
                "expected_copy_b_integrity": {"type": "boolean"},
                "expected_selected_copy": {"enum": ["", "A", "B"]},
                "expected_finding": {"enum": ["", "DTC-REDUNDANCY-LOSS", "DTC-REDUNDANCY-COPY-CORRUPTED", "DTC-REDUNDANCY-ARBITRATION-FAILED", "DTC-REDUNDANCY-RESTORE-FAILED"]}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
