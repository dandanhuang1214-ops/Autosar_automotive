{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automotive-workbench.local/schemas/communication-vectors.schema.json",
  "title": "Bounded classic CAN communication vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vectors"
  ],
  "properties": {
    "schema_version": {
      "const": "communication-vectors-0.1"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "message",
          "direction",
          "signals",
          "timeout_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "not": {
              "pattern": "[^A-Za-z0-9_.-]"
            }
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "direction": {
            "enum": [
              "tx",
              "rx"
            ]
          },
          "signals": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "\\S"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": -1.7976931348623157e+308,
              "maximum": 1.7976931348623157e+308
            }
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5
          }
        }
      }
    }
  },
  "$comment": "Unique vector IDs and DBC/intent-dependent semantic constraints are enforced by preflight."
}
