{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/installed-distribution-smoke.schema.json",
  "title": "Installed Workbench Distribution Smoke",
  "type": "object",
  "required": ["artifact_type", "schema_version", "created_at", "status", "distribution", "runtime", "checks"],
  "properties": {
    "artifact_type": {"const": "installed-distribution-smoke"},
    "schema_version": {"const": "installed-distribution-smoke-0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "passed"},
    "distribution": {
      "type": "object",
      "required": ["name", "version", "wheel", "wheel_sha256", "wheel_size"],
      "properties": {
        "name": {"const": "automotive-workbench"},
        "version": {"type": "string", "minLength": 1},
        "wheel": {"type": "string", "pattern": "^[^/\\\\]+\\.whl$"},
        "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "wheel_size": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["implementation", "python", "platform"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"const": "wheel-built"},
        {"const": "isolated-install"},
        {"const": "distribution-metadata"},
        {"const": "checkout-import-excluded"},
        {"const": "console-entrypoint"},
        {"const": "core-trace"}
      ],
      "items": false
    }
  },
  "additionalProperties": false
}
