{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/uds-intent.schema.json",
  "title": "Vendor-neutral UDS Diagnostic Intent",
  "type": "object",
  "required": ["schema_version", "model_status", "ecu", "transport", "dids", "scenarios"],
  "properties": {
    "schema_version": {"const": "uds-intent-0.1"},
    "model_status": {"enum": ["research-intent", "vendor-validated", "unknown"]},
    "ecu": {"type": "string"},
    "dtc_intent": {"type": "string", "minLength": 1},
    "transport": {
      "type": "object",
      "required": ["addressing", "request_id", "response_id", "tx_data_length"],
      "properties": {
        "addressing": {"enum": ["normal_11bit"]},
        "request_id": {"type": "integer", "minimum": 0, "maximum": 2047},
        "response_id": {"type": "integer", "minimum": 0, "maximum": 2047},
        "tx_data_length": {"const": 8}
      },
      "additionalProperties": true
    },
    "dids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "codec", "length"],
        "properties": {
          "id": {"type": "integer", "minimum": 0, "maximum": 65535},
          "name": {"type": "string"},
          "codec": {"enum": ["ascii", "uint8", "uint16", "uint32", "raw"]},
          "length": {"type": "integer", "minimum": 1},
          "value": {}
        },
        "additionalProperties": true
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "service"],
        "properties": {
          "name": {"type": "string"},
          "service": {"enum": ["ReadDataByIdentifier", "ReadDTCInformation", "ClearDiagnosticInformation"]},
          "did": {"type": "integer", "minimum": 0, "maximum": 65535},
          "subfunction": {"enum": ["reportDTCByStatusMask", "reportDTCSnapshotRecordByDTCNumber"]},
          "status_mask": {"type": "integer", "minimum": 1, "maximum": 255},
          "expected_dtc_records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "status"],
              "properties": {
                "code": {"type": "integer", "minimum": 0, "maximum": 16777215},
                "status": {"type": "integer", "minimum": 0, "maximum": 255}
              },
              "additionalProperties": false
            }
          },
          "dtc": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "record_number": {"type": "integer", "minimum": 1, "maximum": 254},
          "expected_dtc_status": {"type": "integer", "minimum": 0, "maximum": 255},
          "expected_snapshot_records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["did", "value"],
              "properties": {
                "did": {"type": "integer", "minimum": 0, "maximum": 65535},
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "group": {"type": "integer", "minimum": 0, "maximum": 16777215},
          "expected": {"enum": ["positive", "negative_response", "timeout", "malformed_payload"]},
          "nrc": {"type": "string"},
          "response_payload_hex": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
