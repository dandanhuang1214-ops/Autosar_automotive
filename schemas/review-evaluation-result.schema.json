{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automotive-workbench/review-evaluation-result.schema.json",
  "title": "Deterministic Engineering Review Evaluation Result",
  "type": "object",
  "required": ["artifact_type", "schema_version", "run_id", "started_at", "evaluation_id", "status", "case_count", "repeat_runs", "metrics", "cases"],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["review-evaluation-result-0.2", "review-evaluation-result-0.3", "review-evaluation-result-0.4", "review-evaluation-result-0.5", "review-evaluation-result-0.6", "review-evaluation-result-0.7", "review-evaluation-result-0.8", "review-evaluation-result-0.9", "review-evaluation-result-1.0", "review-evaluation-result-1.1", "review-evaluation-result-1.2", "review-evaluation-result-1.3"]}}},
      "then": {"required": ["check_count", "domain_check_counts", "domain_check_accuracy", "split_check_counts", "split_check_accuracy"]}
    },
    {
      "if": {"properties": {"schema_version": {"enum": ["review-evaluation-result-0.8", "review-evaluation-result-0.9", "review-evaluation-result-1.0", "review-evaluation-result-1.1", "review-evaluation-result-1.2", "review-evaluation-result-1.3"]}}},
      "then": {"required": ["drift_status_counts", "domain_drift_status_counts"]}
    },
    {
      "if": {"properties": {"schema_version": {"enum": ["review-evaluation-result-1.1", "review-evaluation-result-1.2", "review-evaluation-result-1.3"]}}},
      "then": {
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "external_reports": {
                  "properties": {
                    "reports": {
                      "items": {"required": ["ci_provenance", "provenance_expectation"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"enum": ["review-evaluation-result-1.2", "review-evaluation-result-1.3"]}}},
      "then": {
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "external_reports": {"required": ["provenance_policy"]}
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "artifact_type": {"const": "engineering-review-evaluation"},
    "schema_version": {"enum": ["review-evaluation-result-0.1", "review-evaluation-result-0.2", "review-evaluation-result-0.3", "review-evaluation-result-0.4", "review-evaluation-result-0.5", "review-evaluation-result-0.6", "review-evaluation-result-0.7", "review-evaluation-result-0.8", "review-evaluation-result-0.9", "review-evaluation-result-1.0", "review-evaluation-result-1.1", "review-evaluation-result-1.2", "review-evaluation-result-1.3"]},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed"]},
    "case_count": {"type": "integer", "minimum": 1},
    "check_count": {"type": "integer", "minimum": 1},
    "repeat_runs": {"type": "integer", "minimum": 1},
    "domain_check_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "domain_check_accuracy": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "split_check_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "split_check_accuracy": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "drift_status_counts": {
      "$ref": "#/$defs/driftStatusCounts"
    },
    "domain_drift_status_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/driftStatusCounts"}
    },
    "metrics": {
      "type": "object",
      "required": ["status_accuracy", "check_state_accuracy", "conflict_recall", "false_conflict_count", "citation_validity", "citation_precision", "citation_evidence_set_recall", "refusal_code_accuracy", "finding_preservation", "repeatability", "drift_catalog_accuracy"],
      "properties": {
        "status_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "check_state_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "conflict_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "false_conflict_count": {"type": "integer", "minimum": 0},
        "citation_validity": {"type": "number", "minimum": 0, "maximum": 1},
        "citation_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "citation_evidence_set_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "refusal_code_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "finding_preservation": {"type": "number", "minimum": 0, "maximum": 1},
        "repeatability": {"type": "number", "minimum": 0, "maximum": 1},
        "drift_catalog_accuracy": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "passed", "observed_status", "observed_checks", "observed_refusal_codes", "citation_count", "repeatable"],
        "properties": {
          "case_id": {"type": "string"},
          "domain": {"type": "string"},
          "split": {"enum": ["development", "runtime", "held-out", "cross-run", "cohort"]},
          "passed": {"type": "boolean"},
          "observed_status": {"enum": ["answered", "partial", "refused"]},
          "observed_checks": {"type": "object", "additionalProperties": {"enum": ["supported", "unsupported", "conflicted", "blocked"]}},
          "observed_refusal_codes": {"type": "array", "items": {"type": "string"}},
          "citation_count": {"type": "integer", "minimum": 0},
          "repeatable": {"type": "boolean"},
          "observed_drift_catalog": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["check_id", "claim_key", "baseline_artifact_id", "candidate_artifact_id", "status"],
              "properties": {
                "check_id": {"type": "string", "minLength": 1},
                "claim_key": {"type": "string", "minLength": 1},
                "baseline_artifact_id": {"type": "string", "minLength": 1},
                "candidate_artifact_id": {"type": "string", "minLength": 1},
                "status": {"enum": ["stable", "drifted", "not-comparable"]}
              },
              "additionalProperties": false
            }
          },
          "producer": {
            "type": "object",
            "required": ["kind", "status"],
            "oneOf": [
              {"required": ["report", "source_sha256"]},
              {"required": ["runs", "reports"]}
            ],
            "properties": {
              "kind": {"enum": ["can-lab", "uds-lab", "dtc-lifecycle"]},
              "report": {"type": "string", "minLength": 1},
              "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "applicability_profile": {
                "type": "object",
                "required": ["variant", "software_version", "calibration_version", "backend"],
                "properties": {
                  "variant": {"type": "string", "minLength": 1},
                  "software_version": {"type": "string", "minLength": 1},
                  "calibration_version": {"type": "string", "minLength": 1},
                  "backend": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              "status": {"const": "passed"},
              "runs": {"enum": [2, 3]},
              "reports": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["report", "source_sha256", "status"],
                  "properties": {
                    "report": {"type": "string", "minLength": 1},
                    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "applicability_profile": {
                      "type": "object",
                      "required": ["variant", "software_version", "calibration_version", "backend"],
                      "properties": {
                        "variant": {"type": "string", "minLength": 1},
                        "software_version": {"type": "string", "minLength": 1},
                        "calibration_version": {"type": "string", "minLength": 1},
                        "backend": {"type": "string", "minLength": 1}
                      },
                      "additionalProperties": false
                    },
                    "status": {"const": "passed"}
                  },
                  "additionalProperties": false
                }
              },
              "mutations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["run", "pointer", "value"],
                  "properties": {
                    "run": {"enum": [1, 2, 3]},
                    "pointer": {"type": "string", "minLength": 1},
                    "value": {"type": ["string", "number", "boolean", "null"]}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "external_reports": {
            "type": "object",
            "required": ["status", "report_count", "reports"],
            "properties": {
              "status": {"const": "verified"},
              "report_count": {"type": "integer", "minimum": 1, "maximum": 3},
              "reports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["report", "source_sha256", "status", "applicability_profile"],
                  "properties": {
                    "report": {"type": "string", "minLength": 1},
                    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "status": {"const": "verified"},
                    "applicability_profile": {
                      "type": "object",
                      "required": ["variant", "software_version", "calibration_version", "backend"],
                      "properties": {
                        "variant": {"type": "string", "minLength": 1},
                        "software_version": {"type": "string", "minLength": 1},
                        "calibration_version": {"type": "string", "minLength": 1},
                        "backend": {"type": "string", "minLength": 1}
                      },
                      "additionalProperties": false
                    },
                    "ci_provenance": {
                      "type": "object",
                      "required": ["provider", "repository", "run_id", "job_id", "commit_sha", "status"],
                      "properties": {
                        "provider": {"type": "string", "minLength": 1},
                        "repository": {"type": "string", "minLength": 1},
                        "run_id": {"type": "string", "minLength": 1},
                        "job_id": {"type": "string", "minLength": 1},
                        "commit_sha": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
                        "status": {"const": "hash-bound"}
                      },
                      "additionalProperties": false
                    },
                    "provenance_expectation": {
                      "type": "object",
                      "required": ["repository", "job_id", "commit_sha", "status"],
                      "properties": {
                        "repository": {"type": "string", "minLength": 1},
                        "job_id": {"type": "string", "minLength": 1},
                        "commit_sha": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
                        "status": {"const": "matched"}
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "provenance_policy": {
                "type": "object",
                "required": ["repository", "allowed_job_ids", "status"],
                "properties": {
                  "repository": {"type": "string", "minLength": 1},
                  "allowed_job_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "status": {"const": "enforced"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "driftStatusCounts": {
      "type": "object",
      "required": ["stable", "drifted", "not-comparable"],
      "properties": {
        "stable": {"type": "integer", "minimum": 0},
        "drifted": {"type": "integer", "minimum": 0},
        "not-comparable": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
