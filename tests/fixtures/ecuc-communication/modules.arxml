                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>HandleB</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanIfHrhCfg</DEFINITION-REF>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanIfHrhCfg/CanIfHrhIdSymRef</DEFINITION-REF>
                  <VALUE-REF>/Demo/Can/ObjectB</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>Can</SHORT-NAME>
          <DEFINITION-REF>/Synthetic/Can</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ObjectA</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanHardwareObject</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF>/Synthetic/CanHardwareObject/CanObjectType</DEFINITION-REF>
                  <VALUE>TRANSMIT</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
              </PARAMETER-VALUES>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanHardwareObject/CanControllerRef</DEFINITION-REF>
                  <VALUE-REF>/Demo/Can/Controller</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>ObjectB</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanHardwareObject</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF>/Synthetic/CanHardwareObject/CanObjectType</DEFINITION-REF>
                  <VALUE>RECEIVE</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
              </PARAMETER-VALUES>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF>/Synthetic/CanHardwareObject/CanControllerRef</DEFINITION-REF>
                  <VALUE-REF>/Demo/Can/Controller</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
              </REFERENCE-VALUES>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>Controller</SHORT-NAME>
              <DEFINITION-REF>/Synthetic/CanController</DEFINITION-REF>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
